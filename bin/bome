#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=../config/env
source "$ROOT_DIR/config/env"
source "$ROOT_DIR/config/bome.sh"

if [[ "${WAYDAW_ABLETON_RUNNER:-}" == proton-exp ]]; then
  # Use the same XWayland display path as the guarded Ableton launch.
  unset WAYLAND_DISPLAY
fi

LOG_DIR="$ROOT_DIR/logs"
LOG_FILE="$LOG_DIR/bome.log"
DEBUG_LOG_FILE="$LOG_DIR/bome-debug.log"
mkdir -p "$LOG_DIR"

debug_mode=0
if [[ "${1:-}" == "--debug" ]]; then
  debug_mode=1
  shift
fi

if ! command -v wine >/dev/null 2>&1; then
  printf 'ERROR: wine not found on PATH.\n' >&2
  exit 1
fi

if [[ ! -d "$WINEPREFIX" ]]; then
  printf 'ERROR: WINEPREFIX does not exist: %s\n' "$WINEPREFIX" >&2
  exit 1
fi

bome_exe="$(waydaw_bome_executable "$WINEPREFIX")"

printf '[%s] launching Bome: %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$bome_exe" >>"$LOG_FILE"

if [[ -n "${WAYDAW_BOME_READY_FILE:-}" ]]; then
  helper="$ROOT_DIR/.local-tools/waydaw-launch/wait-bome.exe"
  [[ -f "$helper" ]] || { printf 'ERROR: build compat/waydaw-launch/build.sh first.\n' >&2; exit 1; }
  # winepath uses the selected runner and the same prefix. Its bootstrap is
  # covered by the supervisor's host-side startup deadline and cancellation.
  windows_path_output="$(winepath -w "$WAYDAW_BOME_READY_FILE" "$bome_exe")"
  mapfile -t windows_paths <<<"$windows_path_output"
  # Some Wine builds emit CRLF even when stdout is redirected on Linux.
  for index in "${!windows_paths[@]}"; do windows_paths[index]="${windows_paths[index]%$'\r'}"; done
  [[ ${#windows_paths[@]} == 2 && -n "${windows_paths[0]}" && -n "${windows_paths[1]}" ]] || {
    printf 'ERROR: could not resolve Bome readiness paths.\n' >&2; exit 1;
  }
  exec wine "$helper" "${windows_paths[0]}" 30000 "${windows_paths[1]}" "$@" >>"$LOG_FILE" 2>&1
fi

if [[ "$debug_mode" -eq 1 ]]; then
  {
    printf '[%s] launching Bome debug\n' "$(date '+%Y-%m-%d %H:%M:%S')"
    printf 'WINEPREFIX=%s\n' "$WINEPREFIX"
    printf 'Bome executable=%s\n' "$bome_exe"
    printf 'WINEDEBUG=+seh,+loaddll\n'
  } | tee -a "$DEBUG_LOG_FILE"

  set +e
  WINEDEBUG=+seh,+loaddll wine "$bome_exe" "$@" 2>&1 | tee -a "$DEBUG_LOG_FILE"
  wine_status="${PIPESTATUS[0]}"
  set -e

  printf '[%s] Bome wine exit code: %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$wine_status" | tee -a "$DEBUG_LOG_FILE"
  exit "$wine_status"
fi

exec wine "$bome_exe" "$@" >>"$LOG_FILE" 2>&1
