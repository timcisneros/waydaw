#!/usr/bin/env bash
# Emergency recovery scoped by the exact prefix and matching wineserver.
# Never kill by process name or command-line regex.
set -euo pipefail
ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source "$ROOT_DIR/config/prefix-safety.sh"
prefix="$(waydaw_copied_prefix)" || exit 1
runner="$ROOT_DIR/.local-runners/kron4ek-proton-exp-11.0/bin/wineserver"
printf 'target_proton_prefix=%s\nrunner_wineserver=%s\n' "$prefix" "$runner"
if [[ "${1:-}" == --dry-run ]]; then
  printf 'would_run=env WINEPREFIX=%q %q -k\n' "$prefix" "$runner"
  printf 'would_run=%q --unload\n' "$ROOT_DIR/bin/ableton-kwin-decoration-controller"
  exit 0
fi
[[ -d "$prefix/drive_c" && -x "$runner" ]] || { echo 'ERROR: copied prefix or matching wineserver is missing.' >&2; exit 1; }
result=0
kill_result=0
timeout --kill-after=1 8 env WINEPREFIX="$prefix" "$runner" -k || kill_result=$?
if timeout --kill-after=1 8 env WINEPREFIX="$prefix" "$runner" -w; then
  # Wine returns 1 from -k when no server is running. A successful -w
  # confirms shutdown; other kill failures still require recovery.
  if [[ "$kill_result" != 0 && "$kill_result" != 1 ]]; then
    printf 'ERROR: wineserver termination failed with exit %s.\n' "$kill_result" >&2
    result=1
  fi
  timeout --kill-after=1 3 "$ROOT_DIR/bin/ableton-kwin-decoration-controller" --unload || result=1
else
  printf 'ERROR: Wine shutdown could not be verified; retaining the KWin controller.\n' >&2
  result=1
fi
printf 'cleanup_exit=%s\n' "$result"
exit "$result"
